# =============================================================================
# xynes-auth-sdk — local-dev env
# =============================================================================
#
# This SDK package is consumed by xynes-auth-app and xynes-cms-console-web.
# It does NOT need its own runtime env when consumed in another app — values
# flow through from the consumer's env.
#
# This file exists for STANDALONE development of the SDK (e.g. running its
# Storybook or test harness against a live backend).
#
# Canonical FE template:
#   ../infra/.env.example
# Canonical platform 3-level env model (Template / Local / Hosted):
#   ../../xynes/xynes-infra/ENV_GUIDE.md
#
# When running SDK tests / Storybook standalone:
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. NEVER commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC (NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------

# Supabase backend the SDK talks to (standalone mode).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Gateway URL the SDK uses for `/me`, `/flags`, etc.
NEXT_PUBLIC_API_URL=http://localhost:4100

# Auth authority app (used by the SDK for redirect flows).
NEXT_PUBLIC_AUTH_APP_URL=http://localhost:3100
